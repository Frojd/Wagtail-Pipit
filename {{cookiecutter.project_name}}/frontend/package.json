{
  "name": "frontend_nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p {{cookiecutter.nextjs_port}}",
    "build": "next build",
    "build:local": "IGNORE_SENTRY=1 next build",
    "start": "PORT={{cookiecutter.nextjs_port}} node .next/standalone/server.js",
    "storybook": "storybook dev -p 3001",
    "build-storybook": "storybook build",
    "fixcode": "prettier --write .",
    "fixcode:check": "prettier --check .",
    "new": "node cli/bin.js new",
    "new:container": "node cli/bin.js new --container",
    "test": "jest --watch",
    "test:ci": "jest --ci --runInBand --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "@sentry/nextjs": "10.74.0",
    "i18next": "26.4.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "storybook": "10.6.0",
    "vite": "8.3.0"
  }
}
