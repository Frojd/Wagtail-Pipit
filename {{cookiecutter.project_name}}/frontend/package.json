{
  "name": "frontend_nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p {{cookiecutter.nextjs_port}}",
    "build": "next build",
    "build:local": "IGNORE_SENTRY=1 next build",
    "start": "PORT={{cookiecutter.nextjs_port}} node .next/standalone/server.js",
    "storybook": "storybook dev -p 3001",
    "build-storybook": "storybook build",
    "fixcode": "prettier --write .",
    "fixcode:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "new": "node cli/new.mts",
    "new:component": "node cli/new.mts",
    "new:container": "node cli/new.mts --container",
    "typecheck": "tsc && tsc -p cli",
    "test": "jest --watch",
    "test:ci": "jest --ci --runInBand --reporters=default --reporters=jest-junit",
    "test:cli": "node --test cli/new.test.mts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.10.0",
    "i18next": "26.5.12",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "jiti": "2.7.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "storybook": "10.6.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5"
  }
}
